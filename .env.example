# Postgres. docker-compose maps 5432 -> 5433 so it does not clash with a local install.
DATABASE_URL=postgresql://sync:sync@localhost:5433/switchboard

# 32 bytes, base64. Provider credentials are AES-256-GCM encrypted with this.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIALS_KEY=

PORT=8000
PUBLIC_URL=http://localhost:8000

# Stripe: test mode secret key, and the signing secret for your webhook endpoint
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# HubSpot: from a developer app
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_WEBHOOK_SECRET=

# Mapping layer. Only used to PROPOSE mappings, never in the sync path.
ANTHROPIC_API_KEY=
MAPPING_MODEL=claude-sonnet-5-5
